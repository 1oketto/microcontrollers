; 1-bit VGA scanout for Pico 2 / RP2350, 300 MHz system clock.
; Each framebuffer bit drives all four color pins: 0 = black, 1 = white.
; 12 system clocks per pixel gives a 25 MHz pixel clock. Both bit values
; take exactly 12 clocks, including the line-counter branch.
.program rgb
.pio_version 1

pull block                  ; initial line count, supplied before DMA starts
mov isr, osr                ; ISR preserves 639 while Y holds each pixel bit
out null, 32                ; discard the control word before pixel autopull
.wrap_target
set pins, 0                 ; black during horizontal/vertical blanking
mov x, isr
wait 1 irq prev 1 [3]       ; consume PIO0 VSync's active-line IRQ from PIO1
pixel:
    out y, 1                ; LSB first, autopull after every 32 pixels
    jmp y-- white           ; Y is 0 or 1 and is overwritten on the next pixel
    set pins, 0 [7]
    jmp next_pixel
white:
    set pins, 15 [8]
next_pixel:
    jmp x-- pixel
.wrap

% c-sdk {
static inline void rgb_program_init(PIO pio, uint sm, uint offset, uint pin) {
    pio_sm_config c = rgb_program_get_default_config(offset);
    sm_config_set_set_pins(&c, pin, 4);
    sm_config_set_out_shift(&c, true, true, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    for (uint i = 0; i < 4; ++i) pio_gpio_init(pio, pin + i);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 4, true);
    pio_sm_init(pio, sm, offset, &c);
}
%}
