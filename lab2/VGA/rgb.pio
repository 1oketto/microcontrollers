; 1-bit Monochrome VGA scanout driver for RP2350 / Pico 2
; Updated from Hunter Adams / Bruce Land 16-color RGB driver

.program rgb
.pio_version 1               ; CHANGED: Targets RP2350 architecture feature set

pull block                   ; Pull initial pixel line count from FIFO into OSR
mov isr, osr                 ; CHANGED: Store line count in ISR instead of Y so Y is free for bit testing
out null, 32                 ; CHANGED: Discard initial 32-bit control word before pixel stream begins

.wrap_target
set pins, 0                  ; Zero RGB pins (black) during horizontal/vertical blanking
mov x, isr                   ; CHANGED: Load line counter into X from ISR (was Y)

wait 1 irq prev 1 [3]        ; CHANGED: Synchronize with VSync IRQ across PIO blocks using 'prev' syntax

pixel:                       ; CHANGED: Replaced manual 4-bit 'pull block' + 'out pins, 4' with conditional pixel branch
    out y, 1                 ; Pull 1 bit into Y register (hardware autopull handles refill every 32 bits)
    jmp y-- white            ; Test Y: if bit was 1, jump to 'white' (Y decrements to 0, resetting it for next pixel)
    
    set pins, 0 [7]          ; BLACK PIXEL: Set all 4 pins LOW (0000). Delay 7 extra cycles (total 12 cycles)
    jmp next_pixel           ; Jump around white label to line loop check

white:
    set pins, 15 [8]         ; WHITE PIXEL: Set all 4 pins HIGH (1111). Delay 8 extra cycles (total 12 cycles)

next_pixel:
    jmp x-- pixel            ; Decrement line counter X and loop until line is complete
.wrap

% c-sdk {
static inline void rgb_program_init(PIO pio, uint sm, uint offset, uint pin) {
    pio_sm_config c = rgb_program_get_default_config(offset);

    // Map SET pin group to 4 pins (lowest pin is passed 'pin' parameter)
    sm_config_set_set_pins(&c, pin, 4);

    // CHANGED: Removed sm_config_set_out_pins() because bit values are set explicitly via 'set pins'
    
    // CHANGED: Enable hardware Autopull (shifts right, autopull enabled, 32-bit threshold)
    // Automatically refills OSR from TX FIFO every 32 bits without needing manual 'pull block' instructions
    sm_config_set_out_shift(&c, true, true, 32);

    // Join RX/TX FIFOs to create an 8-entry deep TX FIFO to prevent starvation
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    // CHANGED: Cleaned up pio_gpio_init calls into a single concise loop for the 4 pins
    for (uint i = 0; i < 4; ++i) {
        pio_gpio_init(pio, pin + i);
    }

    // Set pin direction for all 4 pins to output
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 4, true);

    // Load configuration and set state machine initial PC to program offset
    pio_sm_init(pio, sm, offset, &c);
}
%}
